# Copier en .env (jamais commité — voir .gitignore) et renseigner les vraies valeurs.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Provider LLM utilisé par le moteur pour les étapes classify/chrono/decl.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
MODELE_CLASSIFICATION=claude-haiku-4-5-20251001
MODELE_ANALYSE=claude-sonnet-5

# Origine(s) autorisée(s) à appeler cette API (CORS), séparées par des virgules.
# Optionnel : si absent, le code retombe sur https://antoine-zoller.onrender.com
# et http://localhost:5173 (voir app/main.py) — utile car l'onglet "Environment"
# de Render n'apparaît pas de façon fiable sur ce compte.
FRONTEND_ORIGIN=http://localhost:5173
